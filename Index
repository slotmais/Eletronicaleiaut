<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quiz Eletricidade — Fácil, Médio, Difícil e Desafio</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:#0b1020;color:#e7ecf7;
 min-height:100vh;display:flex;justify-content:center;padding:16px;
 background-image:radial-gradient(600px 300px at 15% 0%,rgba(56,189,248,.10),transparent 60%),radial-gradient(600px 300px at 90% 0%,rgba(247,201,72,.08),transparent 60%)}
.app{width:100%;max-width:680px}
.oculta{display:none}
.card{background:#141d38;border:1px solid rgba(120,150,255,.18);border-radius:16px;padding:24px;box-shadow:0 10px 30px rgba(0,0,0,.35);margin-bottom:14px}
.logo{text-align:center;margin:14px 0 18px}
.logo .raio{font-size:2.6rem}
.logo h1{font-size:1.6rem;letter-spacing:1px}
.logo h1 b{color:#f7c948}
.logo p{color:#8fa0c2;font-size:.92rem;margin-top:4px}
.btn{border:none;border-radius:12px;padding:14px 22px;font-weight:700;font-size:1rem;cursor:pointer;min-height:48px;transition:transform .12s,filter .12s}
.btn:hover{transform:translateY(-2px);filter:brightness(1.08)}
.btn-amarelo{background:linear-gradient(135deg,#f7c948,#f59e0b);color:#221a02;width:100%}
.btn-contorno{background:transparent;color:#e7ecf7;border:2px solid rgba(120,150,255,.3);width:100%}
.linha-btns{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.linha-btns .btn{flex:1;width:auto}
.campo{width:100%;padding:14px;border-radius:12px;border:2px solid rgba(120,150,255,.3);background:#1a2547;color:#e7ecf7;font-size:1.05rem;margin:10px 0 16px}
.modos{display:flex;flex-direction:column;gap:12px;margin-top:8px}
.modo{display:block;width:100%;text-align:left;padding:18px;border-radius:14px;cursor:pointer;color:#e7ecf7;
 background:#1a2547;border:2px solid rgba(120,150,255,.18);transition:transform .12s,border-color .12s}
.modo:hover{transform:translateY(-3px)}
.modo .tit{font-size:1.15rem;font-weight:800;display:flex;align-items:center;gap:8px}
.modo .tit small{font-weight:600;color:#8fa0c2;font-size:.8rem}
.modo p{color:#8fa0c2;font-size:.88rem;margin:6px 0 8px;line-height:1.45}
.modo .info{font-size:.8rem;font-weight:700;padding:4px 10px;border-radius:99px;background:#141d38;border:1px solid rgba(120,150,255,.18)}
.modo-facil{border-color:rgba(34,197,94,.5)}.modo-facil:hover{border-color:#22c55e}.modo-facil .tit{color:#22c55e}
.modo-medio{border-color:rgba(245,158,11,.5)}.modo-medio:hover{border-color:#f59e0b}.modo-medio .tit{color:#f59e0b}
.modo-dificil{border-color:rgba(239,68,68,.5)}.modo-dificil:hover{border-color:#ef4444}.modo-dificil .tit{color:#ef4444}
.modo-desafio{border-color:rgba(56,189,248,.5)}.modo-desafio:hover{border-color:#38bdf8}.modo-desafio .tit{color:#38bdf8}
.topo{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px;font-size:.9rem;font-weight:600}
.chip{background:#1a2547;border:1px solid rgba(120,150,255,.18);border-radius:99px;padding:6px 12px}
.chip.pts{color:#f7c948}
.chip.tempo{color:#38bdf8;font-variant-numeric:tabular-nums}
.chip.mfacil{color:#22c55e;border-color:rgba(34,197,94,.4)}
.chip.mmedio{color:#f59e0b;border-color:rgba(245,158,11,.4)}
.chip.mdificil{color:#ef4444;border-color:rgba(239,68,68,.4)}
.chip.mdesafio{color:#38bdf8;border-color:rgba(56,189,248,.4)}
.chip.mrevisao{color:#8fa0c2;border-color:rgba(120,150,255,.4)}
.barra{height:10px;background:#1a2547;border-radius:99px;overflow:hidden;margin-bottom:16px;border:1px solid rgba(120,150,255,.18)}
.barra i{display:block;height:100%;width:0;background:linear-gradient(90deg,#f7c948,#38bdf8);transition:width .3s}
.qimg{margin-bottom:14px;padding:10px;background:#101832;border:1px solid rgba(120,150,255,.18);border-radius:12px}
.qimg svg{width:100%;max-width:430px;height:auto;display:block;margin:0 auto}
.pergunta{font-size:1.12rem;line-height:1.5;margin-bottom:16px}
.opcoes{display:flex;flex-direction:column;gap:10px}
.opcao{display:flex;gap:12px;align-items:center;width:100%;text-align:left;padding:13px 14px;border-radius:12px;
 background:#1a2547;border:2px solid rgba(120,150,255,.18);color:#e7ecf7;font-size:.97rem;cursor:pointer;min-height:52px;transition:border-color .12s}
.opcao:hover:not(:disabled){border-color:#38bdf8}
.opcao:disabled{cursor:default}
.opcao .letra{flex:0 0 30px;height:30px;border-radius:8px;background:#141d38;border:1px solid rgba(120,150,255,.18);
 display:flex;align-items:center;justify-content:center;font-weight:800}
.opcao.certa{background:rgba(34,197,94,.14);border-color:#22c55e}
.opcao.certa .letra{background:#22c55e;color:#fff;border-color:#22c55e}
.opcao.errada{background:rgba(239,68,68,.14);border-color:#ef4444}
.opcao.errada .letra{background:#ef4444;color:#fff;border-color:#ef4444}
.opcao.fraca{opacity:.5}
.feedback{margin-top:14px;padding:14px;border-radius:12px;background:#1a2547;border:1px solid rgba(120,150,255,.18);font-size:.93rem;line-height:1.55}
.feedback .status{font-weight:800;margin-bottom:6px}
.feedback .status.ok{color:#22c55e}
.feedback .status.erro{color:#ef4444}
.feedback .ref{color:#8fa0c2;font-size:.8rem;margin-top:6px}
.acoes{margin-top:16px;display:flex;justify-content:flex-end}
.resultado{text-align:center}
.resultado .pct{font-size:3rem;font-weight:900;color:#f7c948}
.resultado .classif{display:inline-block;margin:8px 0 14px;padding:8px 20px;border-radius:99px;font-weight:800;border:2px solid #f7c948;color:#f7c948}
.resultado .recorde{margin:4px 0 10px;font-weight:700;color:#38bdf8}
.grade{display:grid;grid-template-columns:repeat(auto-fit,minmax(100px,1fr));gap:10px;margin:14px 0}
.item{background:#1a2547;border:1px solid rgba(120,150,255,.18);border-radius:10px;padding:12px}
.item b{display:block;font-size:1.2rem}
.item span{font-size:.75rem;color:#8fa0c2}
.rodape{color:#8fa0c2;font-size:.75rem;text-align:center;margin:14px 6px 30px;line-height:1.5}
@media(max-width:480px){.pergunta{font-size:1.02rem}.card{padding:18px}}
</style>
</head>
<body>
<div class="app">

  <!-- TELA: NOME DO ALUNO -->
  <div id="tela-nome">
    <div class="logo">
      <div class="raio">⚡</div>
      <h1>ELETRIC <b>QUIZ</b></h1>
      <p>Eletricidade e Eletrônica Básica</p>
    </div>
    <div class="card">
      <h2 style="margin-bottom:6px">Bem-vindo(a)! 👋</h2>
      <p style="color:#8fa0c2">Digite seu nome para começar:</p>
      <input id="inpNome" class="campo" maxlength="30" placeholder="Ex.: Maria Silva" autocomplete="off">
      <button class="btn btn-amarelo" onclick="entrar()">▶ ENTRAR</button>
      <div class="linha-btns"><button class="btn btn-contorno somtoggle" onclick="somToggle()"></button></div>
    </div>
  </div>

  <!-- TELA INICIAL -->
  <div id="tela-inicio" class="oculta">
    <div class="logo">
      <div class="raio">⚡</div>
      <h1>ELETRIC <b>QUIZ</b></h1>
      <p id="ola">Escolha o seu nível</p>
    </div>
    <div class="card">
      <div class="modos">
        <button class="modo modo-facil" onclick="iniciar('facil')">
          <span class="tit">🟢 FÁCIL <small>(Iniciante)</small></span>
          <p>Definições diretas: eletrostática, tensão, corrente, resistência, componentes e segurança.</p>
          <span class="info" id="info-facil"></span>
        </button>
        <button class="modo modo-medio" onclick="iniciar('medio')">
          <span class="tit">🟡 MÉDIO <small>(Intermediário)</small></span>
          <p>Aplicação prática: multímetro, baterias, curtos, circuitos série/paralelo, instalação e NBR-5410.</p>
          <span class="info" id="info-medio"></span>
        </button>
        <button class="modo modo-dificil" onclick="iniciar('dificil')">
          <span class="tit">🔴 DIFÍCIL <small>(Avançado)</small></span>
          <p>Cálculos e interpretação: Leis de Ohm, potência, Vp/Vpp, Req, tolerâncias e defeitos.</p>
          <span class="info" id="info-dificil"></span>
        </button>
        <button class="modo modo-desafio" onclick="iniciar('desafio')">
          <span class="tit">🔵 DESAFIO <small>(Misto — os 3 níveis)</small></span>
          <p>Sorteia questões dos três bancos ao mesmo tempo, com cronômetro mais apertado.</p>
          <span class="info" id="info-desafio"></span>
        </button>
      </div>
      <div class="linha-btns">
        <button id="btnRevTudo" class="btn btn-contorno" onclick="revisarSalvos()">📕 Revisar erros salvos</button>
        <button class="btn btn-contorno somtoggle" onclick="somToggle()"></button>
      </div>
    </div>
  </div>

  <!-- TELA DO QUIZ -->
  <div id="tela-quiz" class="oculta">
    <div class="topo">
      <span class="chip" id="chipModo"></span>
      <span class="chip" id="contador">Questão 1/33</span>
      <span class="chip tempo" id="tempo">⏱ 00:00</span>
      <span class="chip pts" id="pontos">0 pts</span>
    </div>
    <div class="barra"><i id="barra"></i></div>
    <div class="card">
      <div class="qimg" id="quizImg"></div>
      <div class="pergunta" id="pergunta"></div>
      <div class="opcoes" id="opcoes"></div>
      <div class="feedback oculta" id="feedback"></div>
      <div class="acoes">
        <button class="btn btn-amarelo oculta" id="btnProxima" style="width:auto" onclick="proxima()">PRÓXIMA ➜</button>
      </div>
    </div>
  </div>

  <!-- TELA FINAL -->
  <div id="tela-fim" class="oculta">
    <div class="card resultado">
      <h1 style="margin-bottom:6px">🎉 Quiz finalizado!</h1>
      <p id="fimAluno" style="color:#8fa0c2"></p>
      <p id="fimModo" style="color:#8fa0c2;margin-bottom:8px"></p>
      <div class="pct" id="fimPct">0%</div>
      <div class="classif" id="fimClassif"></div>
      <div class="recorde" id="fimRecorde"></div>
      <div class="grade">
        <div class="item"><b id="fimAcertos"></b><span>Acertos</span></div>
        <div class="item"><b id="fimErros"></b><span>Erros</span></div>
        <div class="item"><b id="fimPontos"></b><span>Pontos</span></div>
        <div class="item"><b id="fimTempo"></b><span>Tempo</span></div>
      </div>
      <button id="btnNovamente" class="btn btn-amarelo" onclick="jogarNovamente()">🔁 JOGAR NOVAMENTE (MESMO MODO)</button>
      <button id="btnRevSessao" class="btn btn-contorno oculta" style="margin-top:10px" onclick="revisarSessao()">🔄 REVISAR ERROS DA PARTIDA</button>
      <button class="btn btn-contorno" style="margin-top:10px" onclick="exportarPNG()">📸 EXPORTAR RESULTADO (PNG)</button>
      <button class="btn btn-contorno" style="margin-top:10px" onclick="voltarInicio()">🎮 ESCOLHER OUTRO MODO</button>
    </div>
  </div>

  <div class="rodape">
    Conteúdo baseado nas apostilas “AP ELETRICIDADE.pdf” e “Apostila.pdf” — Eletricidade Básica (Leiaut Carielo).<br>
    ⚠️ Aplicativo educacional: trabalhos em instalações elétricas reais devem ser feitos por profissional qualificado.
  </div>
</div>

