function fmtT(s){s=Math.max(0,Math.floor(s));return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0");}
function embaralhar(arr){for(var i=arr.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=arr[i];arr[i]=arr[j];arr[j]=t;}return arr;}
function mostrar(id){
 ["tela-nome","tela-inicio","tela-quiz","tela-fim"].forEach(function(s){document.getElementById(s).classList.add("oculta");});
 document.getElementById(id).classList.remove("oculta");
 window.scrollTo(0,0);
}
/* ---- localStorage helpers ---- */
function lsGet(k,d){try{var v=localStorage.getItem(k);return v===null?d:v;}catch(e){return d;}}
function lsSet(k,v){try{localStorage.setItem(k,v);}catch(e){}}
function carregarRec(){try{return JSON.parse(lsGet(REC_KEY,"{}"))||{};}catch(e){return {};}}
function carregarErr(){try{return JSON.parse(lsGet(ERR_KEY,"[]"))||[];}catch(e){return [];}}
function salvarErr(a){lsSet(ERR_KEY,JSON.stringify(a));}
function chaveDe(q){for(var b=0;b<BANCOS.length;b++){var i=BANCOS[b].indexOf(q);if(i>=0)return b+":"+i;}return null;}
function addErr(q){var k=chaveDe(q);if(!k)return;var a=carregarErr();if(a.indexOf(k)<0)a.push(k);salvarErr(a);}
function remErr(q){var k=chaveDe(q);if(!k)return;salvarErr(carregarErr().filter(function(x){return x!==k;}));}
function questoesErradas(){return carregarErr().map(function(k){var p=k.split(":");var b=BANCOS[+p[0]];return b?b[+p[1]]:null;}).filter(Boolean);}

/* ---- sons ---- */
var AC=null;
function tom(f,at,d,type){var o=AC.createOscillator(),v=AC.createGain();o.type=type;o.frequency.value=f;
 v.gain.setValueAtTime(0.0001,at);v.gain.exponentialRampToValueAtTime(0.12,at+0.015);v.gain.exponentialRampToValueAtTime(0.0001,at+d);
 o.connect(v);v.connect(AC.destination);o.start(at);o.stop(at+d+0.05);}
function bip(ok){if(!SOM)return;
 try{AC=AC||new(window.AudioContext||window.webkitAudioContext)();var t=AC.currentTime;
  if(ok){tom(660,t,0.12,"sine");tom(880,t+0.1,0.16,"sine");}
  else{tom(300,t,0.18,"square");tom(200,t+0.13,0.22,"square");}
 }catch(e){}}
function somToggle(){SOM=!SOM;lsSet("eqquiz_som",SOM?"1":"0");if(SOM)bip(true);atualizaSom();}
function atualizaSom(){document.querySelectorAll(".somtoggle").forEach(function(b){b.textContent=SOM?"🔊 Sons: ligados":"🔇 Sons: desligados";});}

/* ---- nome / entrada ---- */
function entrar(){
 var v=document.getElementById("inpNome").value.trim();
 NOME=v||"Aluno";
 lsSet("eqquiz_nome",NOME);
 document.getElementById("ola").textContent="Olá, "+NOME+"! Escolha o seu nível:";
 infosInicio();
 mostrar("tela-inicio");
}

/* ---- tela inicial ---- */
function infosInicio(){
 var r=carregarRec();
 Object.keys(MODOS).forEach(function(k){
  var m=MODOS[k],rec=r[k];
  var txt=m.qtd+" por partida · banco com "+m.banco.length+" · +"+m.pts+" pts · ⏱ "+fmtT(m.qtd*m.seg);
  if(rec&&rec.pct!==undefined)txt+=" · 🏆 "+rec.pct+"%";
  document.getElementById("info-"+k).textContent=txt;
 });
 document.getElementById("btnRevTudo").textContent="📕 Revisar erros salvos ("+carregarErr().length+")";
}

/* ---- motor do quiz ---- */
function iniciar(chave){comecar(MODOS[chave].banco,MODOS[chave]);}
function revisarSalvos(){var l=questoesErradas();if(!l.length){alert("Nenhum erro salvo. 🎉");return;}revisar(l);}
function revisarSessao(){revisar(errosSessao);}
function revisar(lista){comecar(lista,{nome:"🔄 Revisão de erros",classe:"mrevisao",pts:0,seg:60,revisao:true});}
function comecar(lista,cfg){
 if(timerId)clearInterval(timerId);
 modoAtual=cfg;
 ordem=embaralhar(lista.slice());
 if(cfg.qtd)ordem=ordem.slice(0,Math.min(cfg.qtd,ordem.length));
 idx=0;acertos=0;pontos=0;errosSessao=[];
 tempoLimite=ordem.length*cfg.seg;tempoRestante=tempoLimite;
 var cm=document.getElementById("chipModo");
 cm.textContent=modoAtual.nome;cm.className="chip "+modoAtual.classe;
 document.getElementById("tempo").textContent="⏱ "+fmtT(tempoRestante);
 mostrar("tela-quiz");
 renderQuestao();
 timerId=setInterval(function(){
  tempoRestante--;
  document.getElementById("tempo").textContent="⏱ "+fmtT(tempoRestante);
  if(tempoRestante<=0){clearInterval(timerId);fim(true);}
 },1000);
}
function renderQuestao(){
 var q=ordem[idx];
 respondida=false;opcoesAtuais=[];
 for(var i=0;i<q.a.length;i++)opcoesAtuais.push({t:q.a[i],certa:(i===q.c)});
 embaralhar(opcoesAtuais);
 document.getElementById("contador").textContent="Questão "+(idx+1)+"/"+ordem.length;
 document.getElementById("pontos").textContent=pontos+" pts";
 document.getElementById("barra").style.width=(idx/ordem.length*100)+"%";
 var qi=document.getElementById("quizImg");
 if(q.img){qi.innerHTML=q.img;qi.classList.remove("oculta");}else{qi.innerHTML="";qi.classList.add("oculta");}
 document.getElementById("pergunta").textContent=q.p;
 document.getElementById("feedback").classList.add("oculta");
 document.getElementById("btnProxima").classList.add("oculta");
 var letras=["A","B","C","D"];
 var caixa=document.getElementById("opcoes");caixa.innerHTML="";
 for(var k=0;k<opcoesAtuais.length;k++){
  var b=document.createElement("button");
  b.className="opcao";
  b.innerHTML='<span class="letra">'+letras[k]+'</span><span>'+opcoesAtuais[k].t+'</span>';
  b.onclick=(function(pos){return function(){responder(pos);};})(k);
  caixa.appendChild(b);
 }
}
function responder(k){
 if(respondida)return;
 respondida=true;
 var q=ordem[idx];
 var acertou=opcoesAtuais[k].certa;
 if(acertou){acertos++;pontos+=modoAtual.pts;remErr(q);}
 else{errosSessao.push(q);addErr(q);}
 bip(acertou);
 var botoes=document.querySelectorAll("#opcoes .opcao");
 var textoCerta="";
 for(var j=0;j<opcoesAtuais.length;j++){
  botoes[j].disabled=true;
  if(opcoesAtuais[j].certa){botoes[j].classList.add("certa");textoCerta=opcoesAtuais[j].t;}
  else if(j===k)botoes[j].classList.add("errada");
  else botoes[j].classList.add("fraca");
 }
 var fb=document.getElementById("feedback");
 fb.classList.remove("oculta");
 fb.innerHTML='<div class="status '+(acertou?"ok":"erro")+'">'+(acertou?"✔ Você acertou!"+(modoAtual.pts?" (+"+modoAtual.pts+" pts)":""):"✘ Você errou.")+'</div>'+
  '<div><b>Resposta correta:</b> '+textoCerta+'</div>'+
  '<div style="margin-top:6px">'+q.e+'</div>'+
  '<div class="ref">📖 Referência: '+q.r+'</div>';
 document.getElementById("pontos").textContent=pontos+" pts";
 document.getElementById("barra").style.width=((idx+1)/ordem.length*100)+"%";
 var bp=document.getElementById("btnProxima");
 bp.classList.remove("oculta");
 bp.textContent=(idx===ordem.length-1)?"✅ VER RESULTADO":"PRÓXIMA ➜";
}
function proxima(){
 idx++;
 if(idx>=ordem.length)fim(false);
 else renderQuestao();
}
function classif(p){
 if(p>=90)return"⚡ Mestre da Eletricidade";
 if(p>=70)return"👏 Muito bom";
 if(p>=50)return"📘 Bom começo";
 return"💪 Continue estudando";
}
function fim(esgotado){
 if(timerId)clearInterval(timerId);
 var chave=null;
 Object.keys(MODOS).forEach(function(k){if(MODOS[k]===modoAtual)chave=k;});
 var total=ordem.length,erros=total-acertos;
 var pct=total?Math.round(acertos/total*100):0;
 var usado=tempoLimite-tempoRestante;
 var recTxt="";
 if(!modoAtual.revisao&&chave){
  var r=carregarRec();var ant=r[chave];
  var novo=!ant||pct>ant.pct||(pct===ant.pct&&pontos>(ant.pts||0));
  if(novo){r[chave]={pct:pct,pts:pontos};lsSet(REC_KEY,JSON.stringify(r));}
  recTxt=novo?"🏆 NOVO RECORDE DO MODO!":"🏆 Recorde do modo: "+r[chave].pct+"% · "+r[chave].pts+" pts";
 }else{
  recTxt="🔄 Partida de revisão — não conta para recorde.";
 }
 var clas=classif(pct);
 document.getElementById("fimAluno").textContent="Aluno(a): "+NOME;
 document.getElementById("fimModo").textContent="Modo: "+modoAtual.nome+(esgotado?" · ⏰ tempo esgotado!":"");
 document.getElementById("fimPct").textContent=pct+"%";
 document.getElementById("fimClassif").textContent=clas;
 document.getElementById("fimRecorde").textContent=recTxt;
 document.getElementById("fimAcertos").textContent=acertos;
 document.getElementById("fimErros").textContent=erros;
 document.getElementById("fimPontos").textContent=pontos;
 document.getElementById("fimTempo").textContent=fmtT(usado);
 document.getElementById("btnNovamente").classList.toggle("oculta",!!modoAtual.revisao);
 var bs=document.getElementById("btnRevSessao");
 if(errosSessao.length){bs.classList.remove("oculta");bs.textContent="🔄 REVISAR ERROS DA PARTIDA ("+errosSessao.length+")";}
 else bs.classList.add("oculta");
 lastRes={nome:NOME,modo:modoAtual.nome,pct:pct,clas:clas,acertos:acertos,erros:erros,pontos:pontos,usado:usado,rec:recTxt,data:new Date().toLocaleString("pt-BR")};
 mostrar("tela-fim");
 infosInicio();
}
function jogarNovamente(){
 var chave=null;
 Object.keys(MODOS).forEach(function(k){if(MODOS[k]===modoAtual)chave=k;});
 if(chave)iniciar(chave);
}
function voltarInicio(){if(timerId)clearInterval(timerId);infosInicio();mostrar("tela-inicio");}

/* ---- exportar resultado em PNG ---- */
function exportarPNG(){
 var r=lastRes;if(!r)return;
 var c=document.createElement("canvas");c.width=900;c.height=1150;
 var x=c.getContext("2d");
 x.fillStyle="#0b1020";x.fillRect(0,0,900,1150);
 x.strokeStyle="rgba(120,150,255,.3)";x.lineWidth=3;x.strokeRect(22,22,856,1106);
 x.textAlign="center";
 x.fillStyle="#f7c948";x.font="bold 46px system-ui";x.fillText("ELETRIC QUIZ",450,110);
 x.fillStyle="#8fa0c2";x.font="24px system-ui";x.fillText("Eletricidade e Eletrônica Básica",450,150);
 x.fillStyle="#e7ecf7";x.font="bold 30px system-ui";x.fillText(r.modo,450,225);
 x.font="24px system-ui";x.fillStyle="#8fa0c2";
 x.fillText("Aluno(a): "+r.nome,450,268);
 x.fillText(r.data,450,302);
 x.fillStyle="#f7c948";x.font="bold 110px system-ui";x.fillText(r.pct+"%",450,445);
 x.font="bold 30px system-ui";x.fillStyle="#e7ecf7";x.fillText(r.clas,450,495);
 var itens=[["Acertos",String(r.acertos)],["Erros",String(r.erros)],["Pontos",String(r.pontos)],["Tempo",fmtT(r.usado)]];
 for(var i=0;i<4;i++){
  var cx=240+(i%2)*420,cy=610+Math.floor(i/2)*170;
  x.fillStyle="#141d38";x.fillRect(cx-170,cy-80,340,150);
  x.strokeStyle="rgba(120,150,255,.3)";x.lineWidth=2;x.strokeRect(cx-170,cy-80,340,150);
  x.fillStyle="#e7ecf7";x.font="bold 44px system-ui";x.fillText(itens[i][1],cx,cy);
  x.fillStyle="#8fa0c2";x.font="22px system-ui";x.fillText(itens[i][0],cx,cy+45);
 }
 x.fillStyle="#38bdf8";x.font="24px system-ui";x.fillText(r.rec,450,940);
 x.fillStyle="#8fa0c2";x.font="18px system-ui";
 x.fillText("Conteúdo baseado nas apostilas AP ELETRICIDADE.pdf e Apostila.pdf (Leiaut Carielo).",450,1030);
 x.fillText("Material educacional — instalações reais exigem profissional qualificado.",450,1062);
 var a=document.createElement("a");
 a.download="resultado-eletric-quiz.png";
 a.href=c.toDataURL("image/png");
 a.click();
}

/* ---- inicialização ---- */
NOME=lsGet("eqquiz_nome","");
SOM=lsGet("eqquiz_som","1")!=="0";
document.getElementById("inpNome").value=NOME;
document.getElementById("inpNome").addEventListener("keydown",function(e){if(e.key==="Enter")entrar();});
atualizaSom();
infosInicio();
</script>
